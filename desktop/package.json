{
  "name": "seed-scout",
  "productName": "Seed Scout",
  "version": "0.1.5",
  "description": "Find Minecraft seeds by the structures and biomes near spawn, with a terrain map.",
  "author": "DefamationStation",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "vendor": "powershell -NoProfile -ExecutionPolicy Bypass -File vendor.ps1",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.defamationstation.seedscout",
    "productName": "Seed Scout",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "loading.html"
    ],
    "extraResources": [
      {
        "from": "../app.py",
        "to": "app/app.py"
      },
      {
        "from": "../build.py",
        "to": "app/build.py"
      },
      {
        "from": "../src",
        "to": "app/src"
      },
      {
        "from": "../web",
        "to": "app/web"
      },
      {
        "from": "vendor/python",
        "to": "python"
      },
      {
        "from": "vendor/jdk",
        "to": "jdk"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Seed-Scout-Setup-${version}.${ext}",
      "differentialPackage": false
    },
    "publish": {
      "provider": "generic",
      "url": "https://raw.githubusercontent.com/DefamationStation/seed-scout/update-feed"
    },
    "electronLanguages": [
      "en-US"
    ]
  },
  "license": "MIT"
}
